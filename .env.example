# ==============================================================================
# NexaFlow Technologies - Environment Variables (Placeholders Only)
# Never commit real secrets (.env) to GitHub or expose them in frontend code.
# ==============================================================================

# Application URL (used for canonical URLs, sitemaps, and Paystack callbacks)
APP_URL="http://localhost:3000"
NODE_ENV="development"

# MongoDB Atlas Connection String (Required for persistent database storage)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexaflow?retryWrites=true&w=majority"

# Session & Authentication Signing Secret (Generate a 64-character random hex string)
JWT_SECRET="replace-with-a-strong-64-char-random-secret"

# Initial Super Admin Setup Token (Required once to create the first admin at /portal-admin)
ADMIN_SETUP_TOKEN="replace-with-one-time-admin-setup-token"

# Paystack Payment Gateway (Server-side secret key; switch pk_test/sk_test to pk_live/sk_live for production)
PAYSTACK_MODE="test"
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"

# Google Sign-In OAuth 2.0 (Optional — for Admin & Learner Google Sign-In)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional Transactional Email Provider (resend | sendgrid)
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM="NexaFlow Technologies <no-reply@yourdomain.com>"

# Optional Google Analytics 4 & Search Console defaults (can also be configured in Admin SEO Settings)
GA_MEASUREMENT_ID=""
GSC_VERIFICATION_TAG=""
